{
  "name": "eg-delivery-print-agent",
  "version": "2.0.0",
  "private": true,
  "description": "Aplicativo local de impressao automatica do EG Delivery.",
  "author": "EG Delivery",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "agent": "node agent.js",
    "printers": "node agent.js --list-printers",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.com.easygrowth.egdelivery.printlink",
    "productName": "EG Delivery Print Link",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "agent.js",
      "package.json",
      "src/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "EG Delivery"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EG Delivery Print Link",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
